{
  "name": "diger",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/check-client-bundle-secrets.ts",
    "check:secrets": "tsx scripts/check-client-bundle-secrets.ts",
    "build:functions": "tsx scripts/build-functions.ts",
    "test": "vitest run",
    "start": "next start",
    "lint": "next lint",
    "agent:typecheck": "tsc -p agent/tsconfig.json",
    "agent:worker": "tsx agent/src/main.ts",
    "heroku-postbuild": "npm ci --prefix agent --no-audit --no-fund && tsc -p agent/tsconfig.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/postcss": "^4.1.11",
    "arabic-persian-reshaper": "^1.0.1",
    "bidi-js": "^1.1.0",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "fflate": "0.8.3",
    "next": "^15.4.8",
    "openai": "^7.32.0",
    "pdfkit": "^0.20.2",
    "postcss": "^8.5.29",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "pg": "^8.13.1",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "puppeteer-core": "^25.13.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.29"
  }
}
