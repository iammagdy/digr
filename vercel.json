{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/watchdog",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "src/app/api/chat/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/chat/accept-quote/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/worker/chunk/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/watchdog/route.ts": {
      "maxDuration": 60
    }
  }
}
