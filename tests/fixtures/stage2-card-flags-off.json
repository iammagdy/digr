 "completed_over_delivery": "<section dir=\"rtl\" data-testid=\"agent-card\" data-phase=\"done\" aria-label=\"مهمتك\" class=\"mt-3 flex w-full max-w-[640px] min-w-0 flex-col gap-3 rounded-[18px] border border-ln bg-sf p-3.5 sm:p-4\"><div class=\"flex flex-col gap-1\" data-testid=\"agent-hero\"><p class=\"m-0 font-semibold leading-[1.8] text-ink text-[14px]\" data-testid=\"agent-summary\">فيديوهان من تيك توك عن «الذكاء الاصطناعي» من مصر بالعربية، مع ٢٠ تعليق من كل فيديو وردودها.</p></div><details class=\"rounded-[14px] border border-ln bg-bg px-3 py-1\" data-testid=\"agent-panel\"><summary class=\"cursor-pointer py-2 text-[13px] font-semibold text-ink\">خطة المهمة</summary><div dir=\"rtl\" data-testid=\"mission-plan-body\"><ol class=\"m-0 list-none p-0\"><li class=\"flex gap-2 py-1.5\" data-testid=\"mission-step-stage-1\" data-state=\"done\" aria-label=\"الفيديوهات: تمّ\"><span class=\"inline-flex h-[18px] w-[18px] shrink-0 items-center justify-center\" data-testid=\"step-icon-done\" aria-hidden=\"true\" style=\"color:var(--ok)\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9.5\" stroke-width=\"1.6\"></circle><path d=\"m8 12.4 2.7 2.7L16 9.6\"></path></svg></span><div class=\"min-w-0 flex-1\"><p class=\"m-0 text-[13px] leading-[1.7] text-ink\">الفيديوهات</p></div></li><li class=\"flex gap-2 py-1.5\" data-testid=\"mission-step-stage-2\" data-state=\"done\" aria-label=\"التعليقات على فيديوهات: تمّ\"><span class=\"inline-flex h-[18px] w-[18px] shrink-0 items-center justify-center\" data-testid=\"step-icon-done\" aria-hidden=\"true\" style=\"color:var(--ok)\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9.5\" stroke-width=\"1.6\"></circle><path d=\"m8 12.4 2.7 2.7L16 9.6\"><