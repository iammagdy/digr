# Environment variables
.env*

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.idea
.agents/
skills-lock.json
/New UI/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# function builds
src/functions/**/dist

# test exports, media and generated outputs (scoped)
/screenshots/
/artifacts_test/
/outputs/
/tests/**/*.pdf
/tests/**/*.png
/tests/**/*.xlsx
/tests/**/*.csv
/scripts/**/*.pdf
/scripts/**/*.png
/scripts/**/*.xlsx
/scripts/**/*.csv
/*.pdf
/*.png
/*.xlsx
/*.csv

# EXCEPTION (Round 37): the three REAL delivered files that tests/round37-real-reels-excel-acceptance.test.ts reads are fixtures, not exports. Without these lines the rules above
# silently keep them out of every commit and the test cannot load on a clean checkout. Only these three names are allowed (their sha256 are in tests/fixtures/round37/README.md).
!/tests/fixtures/round37/delivered.csv
!/tests/fixtures/round37/methodology.csv
!/tests/fixtures/round37/delivered-saved-by-excel-android.xlsx

# the agent worker has its own install (the Claude Agent SDK ships a native binary)
/agent/node_modules

# raw provider pages downloaded from /admin/agent (commenters' names and texts): for the owner's device only, never committed
diger-raw-pages-*.zip
diger-raw-pages.zip
/raw-pages/

# anonymised fixtures ZIPs from the owner (the unzipped, scanned files live in tests/fixtures/live/missions): never committed
diger-fixtures-anon*.zip

# Python bytecode (the fixture anonymiser is a Python script): never committed
__pycache__/
*.pyc

# stray trace output of `next build` when node_modules is a symlink (never source)
/digr/

# the worker's build commit, written by the Heroku build (scripts/write-build-info.mjs)
/agent/build-info.json
